@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Neutral, vocabulary-agnostic core shape. Domain vocabularies (e.g. SAREF) ship
# their own measurement/time-series/sensor shapes via an external enrichment
# config; see the demo deployment and the test fixture under tests/fixtures.
<#QudtUnitMustBeIriShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf qudt:unit ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "qudt:unit must point to a unit IRI node." ;
    ] .
