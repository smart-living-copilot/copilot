{
  "$defs": {
    "VirtualThingBindingView": {
      "additionalProperties": false,
      "description": "The slice of a binding that virtual-servient needs to expose a Thing.\n\nDeliberately omits ``handler_code``, ``capabilities``, ``config``, and\n``state``: the servient never runs handlers (it delegates every interaction\nback to copilot's dispatcher), so shipping handler source or capability\ngrants to it would be needless exposure and wire weight.",
      "properties": {
        "affordance_name": {
          "title": "Affordance Name",
          "type": "string"
        },
        "affordance_type": {
          "enum": [
            "property",
            "action",
            "event"
          ],
          "title": "Affordance Type",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "computed",
            "emitted"
          ],
          "title": "Kind",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/VirtualThingTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "affordance_type",
        "affordance_name",
        "kind"
      ],
      "title": "VirtualThingBindingView",
      "type": "object"
    },
    "VirtualThingTrigger": {
      "additionalProperties": false,
      "properties": {
        "event_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Name"
        },
        "interval_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Seconds"
        },
        "kind": {
          "enum": [
            "interval",
            "source_event",
            "explicit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subscription_input": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subscription Input"
        },
        "thing_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thing Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "VirtualThingTrigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Wire shape served to virtual-servient and the single source of truth for\nthe copilot <-> servient contract.\n\n``apps/virtual-servient/src/types.generated.ts`` is generated from this\nmodel's JSON schema (see ``contract_export``); never hand-edit that file.",
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/VirtualThingBindingView"
      },
      "title": "Bindings",
      "type": "array"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "disabled"
      ],
      "title": "Status",
      "type": "string"
    },
    "td": {
      "additionalProperties": true,
      "title": "Td",
      "type": "object"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "td",
    "version",
    "status",
    "bindings"
  ],
  "title": "VirtualThingServientView",
  "type": "object"
}
