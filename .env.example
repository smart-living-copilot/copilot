# =============================================================================
# Required
# =============================================================================

# LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_BASE_URL=

# Shared secrets
INIT_ADMIN_TOKEN=change-me
INTERNAL_API_KEY=change-me
WOT_RUNTIME_REGISTRY_TOKEN=change-me
WOT_RUNTIME_API_TOKEN=change-me

# =============================================================================
# Optional — Postgres persistence
# =============================================================================

# Docker Compose defaults to these values. If you change them, also set
# REGISTRY_DATABASE_URL to match.
POSTGRES_DB=copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
REGISTRY_DATABASE_URL=postgresql://copilot:copilot@postgres:5432/copilot
# Leave blank to store LangGraph checkpoints in REGISTRY_DATABASE_URL.
AGENT_STATE_DATABASE_URL=

# =============================================================================
# Optional — semantic search
# =============================================================================

OPENAI_EMBEDDING_API_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=mxbai-embed-large
SEARCH_VECTOR_DIMENSIONS=1024

# =============================================================================
# Optional — Thing event outbox
# =============================================================================

THING_EVENT_OUTBOX_BATCH_SIZE=20
THING_EVENT_OUTBOX_POLL_INTERVAL_SECONDS=0.5

# =============================================================================
# Optional — live media (browser camera + microphone)
# =============================================================================

# Self-hosted LiveKit media transport. These defaults match the local
# `livekit` service in docker-compose.
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=smart-living-copilot
LIVEKIT_ROOM_PREFIX=copilot
LIVEKIT_TOKEN_TTL_SECONDS=600

# Speech-to-text
STT_TRANSCRIPTIONS_URL=
STT_MODEL=whisper-large-turbo
STT_API_KEY=
STT_LANGUAGE=

# Text-to-speech
TTS_SPEECH_URL=http://kokoro-tts:8880/v1/audio/speech
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_API_KEY=
TTS_RESPONSE_FORMAT=pcm
TTS_SPEED=1.0

# Vision (look-at-camera tool). Requires an explicitly multimodal model.
# Base URL / key fall back to OPENAI_* when left blank.
VISION_ENABLED=false
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=30
VISION_MAX_IMAGE_DIMENSION=1024
VISION_JPEG_QUALITY=85

# =============================================================================
# Optional — automation jobs
# =============================================================================

# Set false to disable the jobs API in the copilot service. Taskiq worker,
# scheduler, and event consumer processes are configured in docker-compose.
JOBS_ENABLED=true
JOB_TASK_TIMEOUT_SECONDS=300
JOBS_RUN_EVENTS_STREAM=jobs_run_events
JOB_SCHEDULER_UPDATE_INTERVAL_SECONDS=2
# REDIS_URL and WOT_RUNTIME_URL are wired by docker-compose; override only if
# running copilot outside the compose network.
