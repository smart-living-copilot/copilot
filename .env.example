# Required — LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_BASE_URL=

# Required — shared secrets
INIT_ADMIN_TOKEN=change-me
INTERNAL_API_KEY=change-me
WOT_RUNTIME_REGISTRY_TOKEN=change-me
WOT_RUNTIME_API_TOKEN=change-me

# Optional — embedding / semantic search
OPENAI_EMBEDDING_API_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=mxbai-embed-large

# Optional — WebRTC ICE/TURN configuration JSON for browser media ingress
MEDIA_RTC_CONFIGURATION=
MEDIA_SERVER_RTC_CONFIGURATION=
MEDIA_ICE_GATHER_TIMEOUT_MS=750

# Optional — backend speech-to-text for live media mode
STT_ENABLED=false
STT_TRANSCRIPTIONS_URL=
STT_MODEL=whisper-large-turbo
STT_API_KEY=
STT_LANGUAGE=
STT_TIMEOUT_SECONDS=30
STT_SUBMIT_TO_CHAT=true
VAD_THRESHOLD=0.65
VAD_MIN_SPEECH_MS=400
VAD_MIN_SILENCE_MS=800
VAD_SPEECH_PAD_MS=200
VAD_MAX_UTTERANCE_MS=20000
TTS_ENABLED=false
TTS_SPEECH_URL=http://kokoro-tts:8880/v1/audio/speech
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_API_KEY=
TTS_RESPONSE_FORMAT=pcm
TTS_SPEED=1.0
TTS_TIMEOUT_SECONDS=60
