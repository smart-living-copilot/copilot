# LLM Configuration
# One key only. Required by the app and underlying libraries.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1 # Optional: Override for custom endpoints

# WoT Registry API, served by the copilot app in Docker Compose
WOT_REGISTRY_URL=http://copilot:8123
WOT_REGISTRY_TOKEN=              # API key for registry authentication

# Persistence
POSTGRES_DB=copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
REGISTRY_DATABASE_URL=postgresql://copilot:copilot@postgres:5432/copilot
AGENT_STATE_DATABASE_URL=

# Semantic search
SEARCH_VECTOR_DIMENSIONS=1024

# Code Executor
CODE_EXECUTOR_TIMEOUT_SECONDS=330

# Browser media ingress
MEDIA_RTC_CONFIGURATION=
MEDIA_SERVER_RTC_CONFIGURATION=
MEDIA_ICE_GATHER_TIMEOUT_MS=750

# Backend speech-to-text for live media mode
STT_ENABLED=false
STT_TRANSCRIPTIONS_URL=
STT_MODEL=whisper-large-turbo
STT_API_KEY=
STT_LANGUAGE=
STT_TIMEOUT_SECONDS=30
STT_SUBMIT_TO_CHAT=true
VAD_THRESHOLD=0.65
VAD_MIN_SPEECH_MS=400
VAD_MIN_SILENCE_MS=800
VAD_SPEECH_PAD_MS=200
VAD_MAX_UTTERANCE_MS=20000
TTS_ENABLED=false
TTS_SPEECH_URL=http://kokoro-tts:8880/v1/audio/speech
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_API_KEY=
TTS_RESPONSE_FORMAT=pcm
TTS_SPEED=1.0
TTS_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO

# Security
INTERNAL_API_KEY=your-secure-internal-api-key-here
